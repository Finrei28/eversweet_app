generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String          @id @default(cuid())
  username                  String?         @unique
  password                  String
  email                     String          @unique
  emailVerified             DateTime?
  image                     String?
  role                      Role
  anonymousEnabled          Boolean         @default(false)
  requires2FAExpiresAt      DateTime?
  otp                       String?
  otpExpiresAt              DateTime?
  passwordResetOtp          String?
  passwordResetOtpExpiresAt DateTime?
  resetToken                String?
  resetTokenExpiresAt       DateTime?
  passwordChangedAt         DateTime?
  firstName                 String?
  lastName                  String?
  phone                     String?
  stripeCustomerId          String?
  pushToken                 String?
  createdAt                 DateTime        @default(now())
  accounts                  Account[]
  Authenticator             Authenticator[]
  cart                      Cart?
  Loyalty                   Loyalty?
  membership                Membership?
  appOrders                 Order[]           @relation("UserOrders")
  sessions                  Session[]
  loyaltyWinners            LoyaltyWinner[]
  redemptions               OfferRedemption[]
}

model Membership {
  id                    String            @id @default(cuid())
  userId                String            @unique
  planId                String
  startDate             DateTime          @default(now())
  endDate               DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  isActive              Boolean           @default(false)
  cancel                Boolean           @default(false)
  stripePaymentMethodId String?
  stripeSubscriptionId  String?           @unique
  paymentStatus         PaymentStatus     @default(PENDING)
  paymentFailureCode    String?
  paymentFailureMessage String?
  totalMonths           Int               @default(0)
  plan                  MembershipPlan    @relation(fields: [planId], references: [id])
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id                 String       @id @default(cuid())
  name               String
  stripePriceId      String       @unique
  membershipDiscount Int          @default(5)
  maxDiscount        Int          @default(25)
  memberships        Membership[]
}

model Offer {
  id               String             @id @default(cuid())
  name             String
  description      String?
  image            String?
  isActive         Boolean            @default(true)
  /// The offer runs only while `isActive` AND inside this window. NULL is "no bound" on
  /// either end, which is how every offer written before these columns existed behaves -
  /// unchanged. Mirrors Promo.startsAt/endsAt and is read through the same predicate,
  /// isWithinActiveWindow.
  startsAt         DateTime?
  endsAt           DateTime?
  /// Soft delete. Offers are never removed: OrderDessert.offer and CartItem.offer both
  /// cascade from here, so deleting one takes the order lines that used it - and the
  /// shop's sales history - with it.
  archivedAt       DateTime?
  audience         OfferAudience      @default(MEMBERS)
  dessertId        String?
  categoryId       String?
  itemPriceInCents Int?
  /// Whole percent off, 0-100. Was a Decimal holding a fraction (0.2 meaning 20%), which
  /// put a decimal.js instance on every wire and read as `x * 100` in the app and
  /// `1 - x` in the cart. Int matches every other discount here (Promo.value,
  /// MembershipPlan.membershipDiscount).
  ///
  /// Ignored entirely when itemPriceInCents is set - that wins.
  discountAmount   Int?
  limit            Int                @default(1)
  /// `used` on this offer's redemptions resets every Monday, so a membership perk can be
  /// taken once a week. The order server's weekly cron used to be an updateMany with no
  /// WHERE at all, resetting every redemption row in the database - including the
  /// requirement-gated offers closeRun deletes rows precisely to stop handing back.
  ///
  /// Replaces OfferRedemption.renewsAt, dropped as dead in the migration before this:
  /// per-offer is the level this question is actually asked at.
  renewsWeekly     Boolean            @default(false)
  requirements     OfferRequirement[]
  cartItems        CartItem[]
  category         Category?          @relation(fields: [categoryId], references: [id])
  dessert          Dessert?           @relation(fields: [dessertId], references: [id])
  redemptions      OfferRedemption[]
  orderDessert     OrderDessert[]
}

model OfferRequirement {
  id String @id @default(cuid())

  offerId String

  dessertId  String?
  categoryId String?

  quantity Int

  offer Offer @relation(fields: [offerId], references: [id])

  dessert  Dessert?  @relation(fields: [dessertId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
}

model OfferRedemption {
  id         String      @id @default(cuid())
  offerId    String
  userId     String
  unlockedAt DateTime    @default(now())
  redeemedAt DateTime?
  status     OfferStatus
  used       Int         @default(0)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer      Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dessert {
  id                     String              @id @default(cuid())
  name                   String
  chineseName            String
  description            String?
  priceInCents           Int
  imagePath              String
  imagePublicId          String
  isAvailableForPurchase Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  categoryId             String
  priceInLoyaltyPoints   Int                 @default(500)
  cartItems              CartItem[]
  category               Category            @relation(fields: [categoryId], references: [id])
  ingredients            DessertIngredient[]
  offers                 Offer[]
  offerRequirements      OfferRequirement[]
  orders                 OrderDessert[]
  promoId                String?
  promo                  Promo?              @relation(fields: [promoId], references: [id])
}

model Category {
  id                String                  @id @default(cuid())
  name              String
  chineseName       String
  sortOrder         Int?
  customisations    CategoryCustomisation[]
  desserts          Dessert[]
  offers            Offer[]
  offerRequirements OfferRequirement[]
  promoId           String?
  promo             Promo?                  @relation(fields: [promoId], references: [id])
}

model Promo {
  id       String    @id @default(cuid())
  name     String
  type     PromoType
  value    Int
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  desserts   Dessert[]
  categories Category[]
}

model Ingredient {
  id                      String                      @id @default(cuid())
  name                    String
  chineseName             String
  priceInCents            Int
  isAvailableForPurchase  Boolean                     @default(false)
  categories              CategoryCustomisation[]
  customisationInCartItem CustomisationInCartItem[]
  DessertIngredient       DessertIngredient[]
  orderCustomisations     OrderDessertCustomisation[]
}

model DessertIngredient {
  dessertId    String
  ingredientId String
  dessert      Dessert    @relation(fields: [dessertId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dessertId, ingredientId])
}

model CategoryCustomisation {
  id              String     @id @default(cuid())
  categoryId      String
  customisationId String
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customisation   Ingredient @relation(fields: [customisationId], references: [id], onDelete: Cascade)

  @@unique([categoryId, customisationId])
}

model TempOrderCounter {
  id      String @id @default(cuid())
  date    String @unique
  counter Int
}

model Order {
  id                      String         @id @default(cuid())
  tempOrderId             String
  priceInCents            Int
  discountedAmountInCents Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  customerFirstName       String
  customerLastName        String
  customerEmail           String
  customerPhoneNumber     String?
  completedAt             DateTime?
  pickedUpAt              DateTime?
  status                  Status
  dineIn                  Boolean        @default(false)
  pickUpTime              DateTime       @default(now())
  GST                     Int
  appUserId               String?
  source                  OrderSource    @default(WEBSITE)
  // Unique so a retried createOrder can never produce a second order for a
  // charge that was only made once. Postgres treats NULLs as distinct, so
  // orders paid entirely in loyalty points are unaffected.
  paymentIntentId         String?        @unique
  paymentMethodId         String?
  notified                Boolean        @default(false)
  appUser                 User?          @relation("UserOrders", fields: [appUserId], references: [id])
  desserts                OrderDessert[]

  @@index([status])
  // Serves the repeat-order check createPaymentIntent runs before charging.
  @@index([appUserId, createdAt])
}

model OrderDessertCustomisation {
  id                      String       @id @default(cuid())
  orderDessertId          String
  customisationId         String
  discountedAmountInCents Int          @default(0)
  quantity                Int          @default(1)
  customisation           Ingredient   @relation(fields: [customisationId], references: [id], onDelete: Cascade)
  orderDessert            OrderDessert @relation(fields: [orderDessertId], references: [id], onDelete: Cascade)
}

model OrderDessert {
  id                      String                      @id @default(cuid())
  orderId                 String
  dessertId               String
  offerId                 String?
  quantity                Int
  priceInCents            Int                         @default(0)
  discountedAmountInCents Int                         @default(0)
  promoId                 String?
  loyaltyPointsUsed       Int?
  dessert                 Dessert                     @relation(fields: [dessertId], references: [id])
  order                   Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer                   Offer?                      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customisations          OrderDessertCustomisation[]

  @@unique([orderId, dessertId, id])
  // Serves the GROUP BY dessertId aggregate behind getMostPopularProducts.
  // The composite unique above leads with orderId, so it cannot serve it.
  @@index([dessertId])
}

model Feedback {
  id              String   @id @default(cuid())
  rating          Int
  createdAt       DateTime @default(now())
  feedbackMessage String
  name            String?
  email           String
}

model Loyalty {
  id      String          @id @default(cuid())
  points  Int
  userId  String          @unique
  User    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records LoyaltyRecord[]
}

model LoyaltyRecord {
  id        String   @id @default(cuid())
  change    Int // positive = earned, negative = spent
  reason    String
  createdAt DateTime @default(now())

  loyaltyId String
  loyalty   Loyalty @relation(fields: [loyaltyId], references: [id])
}

model LoyaltyWinner {
  id     String  @id @default(cuid())
  userId String?
  /// SetNull rather than Cascade: closing an account used to delete the record that
  /// they had won, which the shop still needs afterwards. Nulling the link anonymises
  /// the row instead, and leaves the prize unclaimable — correct, since there is no
  /// longer anyone to claim it.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 1, 2 or 3. Defaults to 1 so every row written while only first place was
  /// recorded is already a valid first place under the unique index below.
  place  Int     @default(1)

  month     Int
  year      Int
  points    Int
  createdAt DateTime @default(now())

  reward WinnerReward?

  @@unique([month, year, place]) // one winner per place per month
  @@index([userId])
}

/// What the shop owes a monthly winner, and the code they collect it with.
///
/// Deliberately not an Offer: OfferAudience has no way to name one person, and
/// renewMochiOffer resets `used` on every OfferRedemption row weekly, which would make
/// a won prize collectable again every Monday.
model WinnerReward {
  id       String        @id @default(cuid())
  winnerId String        @unique
  winner   LoyaltyWinner @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  /// Free text. The prize is whatever the shop decides and differs per winner, so
  /// there is nothing structured to model here.
  title       String
  description String?

  /// Shown at the counter and typed in by staff. Stored readable because the winner
  /// re-reads it every time they open the app, so it cannot be a one-way hash the way
  /// User.resetToken is. What protects it is that only an ADMIN request can test a
  /// code at all, plus 30^8 of entropy and a single-use claim.
  code String @unique

  /// End of the month after the one that was won, so assigning late does not extend
  /// the deadline. Hard: past this the app stops showing the code and the counter
  /// refuses it.
  expiresAt DateTime

  assignedAt        DateTime  @default(now())
  assignedByAdminId String?
  redeemedAt        DateTime?
  redeemedByAdminId String?

  @@index([redeemedAt])
}

model Cart {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  createdAt              DateTime   @default(now())
  expiresAt              DateTime?
  totalLoyaltyPointsUsed Int        @default(0)
  totalPriceInCents      Int        @default(0)
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems              CartItem[]
}

model CartItem {
  id                      String                    @id @default(cuid())
  dessertId               String
  itemPriceInCents        Int
  discountedAmountInCents Int                       @default(0)
  isPromotionItem         Boolean                   @default(false)
  promotionType           String?
  createdAt               DateTime                  @default(now())
  quantity                Int
  loyaltyPointsUsed       Int?
  cartId                  String
  offerId                 String?
  cart                    Cart                      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  dessert                 Dessert                   @relation(fields: [dessertId], references: [id])
  offer                   Offer?                    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customisations          CustomisationInCartItem[]

  @@unique([cartId, promotionType, dessertId])
}

model CustomisationInCartItem {
  id                      String     @id @default(cuid())
  cartItemId              String
  customisationId         String
  discountedAmountInCents Int        @default(0)
  quantity                Int        @default(1)
  cartItem                CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  customisation           Ingredient @relation(fields: [customisationId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, customisationId])
}

/// How long each size of order takes to make, in minutes.
///
/// One row. Everything about order timing derives from these numbers: the
/// kitchen is alerted `prep + kitchenSlack` before pick-up, and the customer is
/// quoted `max(prep, quoteFloor)`. Kept in the database so the shop can tune
/// them as it learns real timings, rather than needing a deploy.
///
/// The defaults reproduce the behaviour that was previously hardcoded.
model PrepTimeSetting {
  id           String   @id @default(cuid())
  /// Minutes to make an order of this size.
  singleItem   Int      @default(5)
  upToThree    Int      @default(10)
  upToSix      Int      @default(15)
  moreThanSix  Int      @default(20)
  /// Added to the prep time to decide when the kitchen is told to start.
  kitchenSlack Int      @default(1)
  /// The customer is never quoted less than this, however quick the order is.
  quoteFloor   Int      @default(10)
  updatedAt    DateTime @updatedAt
}

model RestaurantStatus {
  id                 String    @id @default(cuid())
  dineInAvailability Boolean
  unavailableUntil   DateTime?
}

model DaysOff {
  id        String   @id @default(cuid())
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

enum OfferStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum OfferAudience {
  MEMBERS
  EVERYONE
  NEW_USERS
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  USER
}

enum OrderSource {
  WEBSITE
  APP
}

enum Status {
  PENDING
  ACCEPTED
  MAKING
  READY
  PICKED_UP
}

enum IngredientType {
  MOCHI
  GLUTINOUS_BALLS
  OSMANTHUS
  TARO
  MANGO
  PURPLE_RICE
  GRAPES
  BOBA
  RED_BEANS
  SAGO
  COCONUT_JELLY
  GRASS_JELLY
  TARO_CREAM
  SNOW_SWALLOW
  PEACH_GUM
  COCONUT_MILK
  MILK_PUDDING
  BLACK_SESAME
  PEANUT
  MUNG_BEAN
  PISTACHIO
  PUMPKIN
  TARO_BALLS
  SWEET_POTATO
  NOODLES
  BROWN_SUGAR
  TOFU
  DURIAN
}
